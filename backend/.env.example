# CampusConnect Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campusconnect?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
